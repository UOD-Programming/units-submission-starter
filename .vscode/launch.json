// Do not edit these files. Any changes may result in errors when running the units tests.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current Unit File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}/../..",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
